namespace Funcky.Extensions
{
    public static class EnumerableExtensions
    {
        extension(System.Linq.Enumerable)
        {
            public static System.Collections.Generic.IEnumerable<T> Return<T>(T value) => null!;
        }
    }
}

namespace WithUsing
{
    using System.Linq;
    using Funcky.Extensions;

    public class C
    {
        public void M()
        {
            _ = Enumerable.Repeat(10, 1);
        }
    }
}

namespace WithFullyQualifiedName
{
    using Funcky.Extensions;

    public class C
    {
        public void M()
        {
            _ = System.Linq.Enumerable.Repeat(10, 1);
        }
    }
}

namespace WithUsingAlias
{
    using Funcky.Extensions;
    using Seq = System.Linq.Enumerable;

    public class C
    {
        public void M()
        {
            _ = Seq.Repeat(10, 1);
        }
    }
}
