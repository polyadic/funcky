using System;
using System.Linq;
using Funcky.Extensions;

namespace Funcky.Extensions {
    public static class EnumerableExtensions {
        extension(Enumerable) { public static string Return(string value) => value; }
    }
}

namespace ConsoleApplication1
{
    class Program
    {
        private void Syntax()
        {
            var single = Enumerable.Return("Hello world!");
        }
    }
}
