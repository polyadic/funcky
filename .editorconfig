root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{props,slnx,targets}]
indent_style = tab

[*.{slnx}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[*.verified.cs]
trim_trailing_whitespace = false
insert_final_newline = false

# The test projects exercise the classic and the C# 14 extension form of every API on purpose.
[*.Test/**.cs]
dotnet_diagnostic.λ1201.severity = none
dotnet_diagnostic.λ1202.severity = none
dotnet_diagnostic.λ1203.severity = none

# The library implements both forms itself; the rules address its consumers.
[Funcky/**.cs]
dotnet_diagnostic.λ1201.severity = none
dotnet_diagnostic.λ1202.severity = none
