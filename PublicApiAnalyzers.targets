<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!-- The public API differs between target frameworks (e.g. the async APIs are only part of Funcky on .NET 10,
	     the generic parse methods need .NET 7, Chunk is an extension method only below .NET 6), so every target
	     framework is checked against its own pair of PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt files in
	     PublicAPI/<group>/. The group defaults to the target framework; a project whose public API is identical on
	     several target frameworks can map them to one shared directory by setting 'FunckyPublicApiGroup'.

	     To add a new API, add it to the PublicAPI.Unshipped.txt of every target framework that compiles it. The
	     code fix of RS0016 does that for the current target framework; from the command line, run 'dotnet format analyzers'
	     on the project once per framework with the environment variable TargetFramework set to that framework (this
	     turns the multi-targeting project into a single-targeting one for that run) and the options 'diagnostics RS0016',
	     'severity info' and 'include-generated', each with the usual two leading dashes (which an XML comment cannot
	     contain). 'include-generated' is needed for the source-generated parse methods. -->
	<PropertyGroup>
		<FunckyPublicApiGroup Condition="'$(FunckyPublicApiGroup)' == ''">$(TargetFramework)</FunckyPublicApiGroup>
		<FunckyPublicApiDirectory>$(MSBuildProjectDirectory)/PublicAPI/$(FunckyPublicApiGroup)/</FunckyPublicApiDirectory>
	</PropertyGroup>
	<!-- The BCL of these target frameworks has no (netstandard2.0) or incomplete (netstandard2.1, netcoreapp3.1)
	     nullable annotations. The source-generated parse methods take over the nullability of the wrapped TryParse
	     methods, so their parameters are oblivious there. The analyzer records such APIs with a leading '~' and
	     additionally reports RS0041 for each of them, which nothing in this repository can fix. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1' or '$(TargetFramework)' == 'netcoreapp3.1'">
		<NoWarn>$(NoWarn);RS0041</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
		<AdditionalFiles Include="$(FunckyPublicApiDirectory)PublicAPI.Shipped.txt" Link="PublicAPI/$(FunckyPublicApiGroup)/PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="$(FunckyPublicApiDirectory)PublicAPI.Unshipped.txt" Link="PublicAPI/$(FunckyPublicApiGroup)/PublicAPI.Unshipped.txt" />
	</ItemGroup>
	<PropertyGroup>
		<CoreCompileDependsOn>$(CoreCompileDependsOn);_ValidateFunckyPublicApiFilesExist</CoreCompileDependsOn>
	</PropertyGroup>
	<Target Name="_ValidateFunckyPublicApiFilesExist" Condition="'$(TargetFramework)' != '' and (!Exists('$(FunckyPublicApiDirectory)PublicAPI.Shipped.txt') or !Exists('$(FunckyPublicApiDirectory)PublicAPI.Unshipped.txt'))">
		<Error Text="The public API files for '$(TargetFramework)' (group '$(FunckyPublicApiGroup)') are missing; expected PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt in '$(FunckyPublicApiDirectory)'" File="$(MSBuildProjectFullPath)" />
	</Target>
</Project>
