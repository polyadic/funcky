<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <ItemGroup Condition="'$(FunckyImplicitUsings)' == 'true' Or '$(FunckyImplicitUsings)' == 'enable'">
        <Using Include="Funcky" />
        <Using Include="Funcky.Extensions" />
        <Using Include="Funcky.Monads" />
        <Using Include="Funcky.Functional" Static="true" />
    </ItemGroup>

    <!-- Built-in analyzers.
         The Funcky package ships its analyzers once per supported Roslyn version (analyzers/dotnet/roslyn3.7/cs and
         analyzers/dotnet/roslyn4.4/cs). SDKs that support analyzer versioning (.NET 6 and newer) pick the newest
         compatible directory on their own. Older SDKs load every analyzer they find, so the targets below keep only
         the Roslyn 3.7 assets there. Adapted from the targets that System.Text.Json ships. -->
    <Target Name="_Funcky_GatherBuiltinAnalyzers">
        <ItemGroup>
            <_FunckyBuiltinAnalyzer Include="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Funcky'" />
        </ItemGroup>
    </Target>

    <Target Name="_Funcky_BuiltinAnalyzerMultiTargeting"
            Condition="'$(SupportsRoslynComponentVersioning)' != 'true'"
            AfterTargets="ResolvePackageDependenciesForBuild;ResolveNuGetPackageAssets"
            DependsOnTargets="_Funcky_GatherBuiltinAnalyzers">
        <ItemGroup>
            <Analyzer Remove="@(_FunckyBuiltinAnalyzer)"
                      Condition="$([System.String]::Copy('%(_FunckyBuiltinAnalyzer.Identity)').IndexOf('roslyn4')) &gt;= 0" />
        </ItemGroup>
    </Target>

    <!-- Set <FunckyDisableBuiltinAnalyzers>true</FunckyDisableBuiltinAnalyzers> to opt out of the built-in analyzers
         entirely. Prefer configuring individual rules in .editorconfig; this switch is the escape hatch for build
         environments where the analyzers cannot run at all. -->
    <Target Name="_Funcky_RemoveBuiltinAnalyzers"
            Condition="'$(FunckyDisableBuiltinAnalyzers)' == 'true'"
            AfterTargets="ResolvePackageDependenciesForBuild;ResolveNuGetPackageAssets"
            DependsOnTargets="_Funcky_GatherBuiltinAnalyzers">
        <ItemGroup>
            <Analyzer Remove="@(_FunckyBuiltinAnalyzer)" />
        </ItemGroup>
    </Target>
</Project>
