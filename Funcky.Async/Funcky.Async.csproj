<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Starting with .NET 10, IAsyncEnumerable LINQ is part of the base class library and Funcky's
             async APIs live in the Funcky package itself. The net10.0 asset of this package therefore only
             contains type forwards to Funcky, so projects that reference both packages keep compiling.
             On older frameworks this package compiles Funcky's async sources (linked from the Funcky project)
             against System.Linq.Async; see Internal\SystemLinqAsyncAdapter.cs for how the two operator
             vocabularies are bridged. The package is compiled against the lowest supported System.Linq.Async
             version (5.0.0) so that the shipped binary works with every version in the allowed range; CI runs
             the tests against each version of the range (see the SystemLinqAsyncVersion matrix in build.yml
             and Funcky.Async.Test.csproj), which exercises exactly the binary compatibility consumers rely on. -->
        <FunckyNewestTargetFramework>net9.0</FunckyNewestTargetFramework>
        <TargetFrameworks>net11.0;net10.0;$(FunckyNewestTargetFramework);net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <!-- The package deliberately keeps targeting frameworks that are out of support, see SupportPolicy.md. -->
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <Description>Extends Funcky with support for IAsyncEnumerable and Tasks on frameworks older than .NET 10. On .NET 10 and newer these APIs are part of the Funcky package and this package only forwards to them.</Description>
        <PackageTags>Functional Async Monad Linq</PackageTags>
        <VersionPrefix>1.6.0</VersionPrefix>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>package.md</PackageReadmeFile>
    </PropertyGroup>
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisModeReliability>All</AnalysisModeReliability>
        <EnablePackageValidation>true</EnablePackageValidation>
        <NoWarn>$(NoWarn);RS0026</NoWarn><!-- RS0026: Do not add multiple overloads with optional parameters -->
        <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
    </PropertyGroup>
    <PropertyGroup>
        <RootNamespace>Funcky</RootNamespace>
        <DefineConstants>$(DefineConstants);CONTRACTS_FULL</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
        <FunckyAsyncIntegrated>true</FunckyAsyncIntegrated>
    </PropertyGroup>
    <PropertyGroup Condition="'$(FunckyAsyncIntegrated)' != 'true'">
        <!-- ASYNC_SUPPORTED enables the async sources shared with Funcky (Funcky itself defines it for net10.0 and newer);
             SYSTEM_LINQ_ASYNC marks the few places where System.Linq.Async differs from the .NET 10 base class library. -->
        <DefineConstants>$(DefineConstants);ASYNC_SUPPORTED;SYSTEM_LINQ_ASYNC</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup Condition="'$(FunckyAsyncIntegrated)' == 'true'">
        <Compile Remove="**\*.cs" />
        <Compile Include="TypeForwards.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(FunckyAsyncIntegrated)' != 'true'">
        <Compile Remove="TypeForwards.cs" />
        <!-- The async implementation itself, shared with Funcky. -->
        <Compile Include="..\Funcky\AsyncSequence\*.cs" LinkBase="AsyncSequence" />
        <Compile Include="..\Funcky\Extensions\AsyncEnumerableExtensions\*.cs" LinkBase="Extensions\AsyncEnumerableExtensions" />
        <Compile Include="..\Funcky\Functional\RetryAsync.cs" LinkBase="Functional" />
        <Compile Include="..\Funcky\Functional\RetryWithExceptionAsync.cs" LinkBase="Functional" />
        <Compile Include="..\Funcky\Monads\Either\EitherAsyncExtensions.*.cs" LinkBase="Monads\Either" />
        <Compile Include="..\Funcky\Monads\Option\ConfiguredOptionTaskAwaitable.cs" LinkBase="Monads\Option" />
        <Compile Include="..\Funcky\Monads\Option\ConfiguredOptionValueTaskAwaitable.cs" LinkBase="Monads\Option" />
        <Compile Include="..\Funcky\Monads\Option\OptionAsyncExtensions.*.cs" LinkBase="Monads\Option" />
        <Compile Include="..\Funcky\Monads\Option\OptionExtensions.ToAsyncEnumerable.cs" LinkBase="Monads\Option" />
        <Compile Include="..\Funcky\Monads\Option\OptionTaskAwaiter.cs" LinkBase="Monads\Option" />
        <Compile Include="..\Funcky\Monads\Option\OptionValueTaskAwaiter.cs" LinkBase="Monads\Option" />
        <Compile Include="..\Funcky\Monads\Result\ResultAsyncExtensions.*.cs" LinkBase="Monads\Result" />
        <Compile Include="..\Funcky\IAsyncBuffer.cs" />
        <Compile Include="..\Funcky\ValueTaskFactory.cs" />
        <!-- Internal helpers of Funcky used by the async implementation. -->
        <Compile Include="..\Funcky\Internal\Aggregators\AverageAggregator.cs" Link="Internal\Aggregators\AverageAggregator.cs" />
        <Compile Include="..\Funcky\Internal\Aggregators\AverageAggregators.cs" Link="Internal\Aggregators\AverageAggregators.cs" />
        <Compile Include="..\Funcky\Internal\Aggregators\IAverageArithmetic.cs" Link="Internal\Aggregators\IAverageArithmetic.cs" />
        <Compile Include="..\Funcky\Internal\Aggregators\MaxAggregator.cs" Link="Internal\Aggregators\MaxAggregator.cs" />
        <Compile Include="..\Funcky\Internal\Aggregators\MinAggregator.cs" Link="Internal\Aggregators\MinAggregator.cs" />
        <Compile Include="..\Funcky\Internal\Mixer.cs" Link="Internal\Mixer.cs" />
        <Compile Include="..\Funcky\Internal\RandomProvider.cs" Link="Internal\RandomProvider.cs" />
        <Compile Include="..\Funcky\Internal\SlidingWindowQueue.cs" Link="Internal\SlidingWindowQueue.cs" />
        <Compile Include="..\Funcky\Internal\UnsafeEither.cs" Link="Internal\UnsafeEither.cs" />
        <Compile Include="..\Funcky\Internal\Validators\WindowWidthValidator.cs" Link="Internal\Validators\WindowWidthValidator.cs" />
        <Compile Include="..\Funcky\Internal\Validators\ChunkSizeValidator.cs" Link="Internal\Validators\ChunkSizeValidator.cs" />
        <Compile Include="..\Funcky\Internal\Validators\RepeatCountValidator.cs" Link="Internal\Validators\RepeatCountValidator.cs" />
        <Compile Include="..\Funcky\Internal\Validators\ArgumentValidator.cs" Link="Internal\Validators\ArgumentValidator.cs" />
        <Compile Include="..\Funcky\Internal\PartitionBuilder.cs" Link="Internal\PartitionBuilder.cs" />
        <PackageReference Include="System.Linq.Async" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="PolySharp" PrivateAssets="all" />
        <PackageReference Include="Polyadic.Build.SemanticVersioning" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Funcky\Funcky.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\Artwork\logo-green-rounded.png" Pack="true" PackagePath="\icon.png" Visible="false" />
        <None Include="package.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <Import Project="..\Analyzers.props" />
    <Import Project="..\GlobalUsings.props" />
    <Import Project="..\FrameworkFeatureConstants.props" />
    <PropertyGroup Condition="'$(FunckyAsyncIntegrated)' != 'true' and '$(TargetFramework)' != 'netstandard2.0'">
        <!-- The public API is identical on every target framework except net10.0 and newer (type forwards only) and netstandard2.0 (no System.Index). -->
        <FunckyPublicApiGroup>common</FunckyPublicApiGroup>
    </PropertyGroup>
    <Import Project="..\PublicApiAnalyzers.targets" />
</Project>
