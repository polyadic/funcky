<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime Dependencies">
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
    <PackageVersion Include="System.Collections.Immutable" Version="1.7.1" />
    <PackageVersion Include="System.Text.Json" Version="5.0.2" />
    <PackageVersion Include="xunit.assert" Version="[2.9.3, 2.10)" />
    <PackageVersion Include="xunit.extensibility.core" Version="[2.9.3, 2.10)" />
    <PackageVersion Include="xunit.v3.assert" Version="[1.0.1, 5)" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="[1.0.1, 5)" />
    <!-- Funcky.Async 2.x compiles against System.Linq.AsyncEnumerable, the package that is the IAsyncEnumerable LINQ of the
		     .NET 10 base class library, so Funcky's async sources compile identically against the base class library (net10.0
		     and newer) and against this package (older frameworks). It is deliberately not System.Linq.Async 7: that package is a
		     facade over System.Linq.AsyncEnumerable which also drags System.Interactive.Async in, whose Merge on a sequence of
		     sequences wins overload resolution over Funcky's sorted Merge (it has no optional comparer parameter) and would change
		     the behaviour of every consumer silently. A consumer that still references System.Linq.Async 5 or 6 gets a type clash
		     (CS0433) on System.Linq.AsyncEnumerable and upgrades to System.Linq.Async 7 or drops the reference; Funcky.Async 1.x
		     stays the line for projects that cannot. 10.0.6 is the first version whose dependencies carry no known vulnerability.
		     The net10.0 and net11.0 assets of Funcky.Async only forward to Funcky and have no dependency at all. -->
    <PackageVersion Include="System.Linq.AsyncEnumerable" Version="[10.0.6, 12)" />
  </ItemGroup>
  <ItemGroup Label="Build Dependencies">
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="Polyadic.Build.SemanticVersioning" Version="1.0.0" />
    <PackageVersion Include="Polyadic.CodeStyle" Version="1.2.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Test Dependencies">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="1.0.1" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.6.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Verify.XUnit" Version="31.12.5" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeRefactoring.Testing" Version="1.1.4" />
  </ItemGroup>
  <ItemGroup Label="Transient Test Dependencies">
    <PackageVersion Include="Nuget.Packaging" Version="7.9.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="xunit.extensibility.execution" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup Label="Analyzer">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- We explicitly reference these analyzers to get the latest version even though we might not use the latest version of Microsoft.CodeAnalysis everywhere. -->
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.0.1597" />
  </ItemGroup>
</Project>
